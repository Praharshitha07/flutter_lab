import 'package:flutter/material.dart';

void main() {
  runApp(const MyApp());
}

class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      home: const AnimationEffectsPage(),
    );
  }
}

class AnimationEffectsPage extends StatefulWidget {
  const AnimationEffectsPage({super.key});

  @override
  State<AnimationEffectsPage> createState() =>
      _AnimationEffectsPageState();
}

class _AnimationEffectsPageState
    extends State<AnimationEffectsPage>
    with SingleTickerProviderStateMixin {
  late AnimationController controller;

  String selectedAnimation = 'Fade';

  @override
  void initState() {
    super.initState();

    controller = AnimationController(
      vsync: this,
      duration: const Duration(seconds: 2),
    );
  }

  void playAnimation(String animationName) {
    setState(() {
      selectedAnimation = animationName;
    });

    controller.reset();
    controller.forward();
  }

  @override
  void dispose() {
    controller.dispose();
    super.dispose();
  }

  Widget animatedWidget() {
    if (selectedAnimation == 'Fade') {
      return FadeTransition(
        opacity: controller,
        child: const Box(),
      );
    }

    if (selectedAnimation == 'Slide') {
      return SlideTransition(
        position: Tween<Offset>(
          begin: const Offset(-1, 0),
          end: Offset.zero,
        ).animate(controller),
        child: const Box(),
      );
    }

    if (selectedAnimation == 'Scale') {
      return ScaleTransition(
        scale: Tween<double>(
          begin: 0.2,
          end: 1.0,
        ).animate(controller),
        child: const Box(),
      );
    }

    return RotationTransition(
      turns: controller,
      child: const Box(),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: Colors.indigo[50],

      appBar: AppBar(
        title: const Text(
          'Animation Effects',
          style: TextStyle(
            color: Colors.white,
            fontWeight: FontWeight.bold,
          ),
        ),
        centerTitle: true,
        backgroundColor: Colors.indigo,
      ),

      body: Center(
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            AnimatedBuilder(
              animation: controller,
              builder: (context, child) {
                return animatedWidget();
              },
            ),

            const SizedBox(height: 40),

            Text(
              '$selectedAnimation Animation',
              style: const TextStyle(
                fontSize: 22,
                fontWeight: FontWeight.bold,
                color: Colors.indigo,
              ),
            ),

            const SizedBox(height: 25),

            // Fade Button
            ElevatedButton(
              onPressed: () {
                playAnimation('Fade');
              },
              child: const Text('Fade'),
            ),

            const SizedBox(height: 10),

            // Slide Button
            ElevatedButton(
              onPressed: () {
                playAnimation('Slide');
              },
              child: const Text('Slide'),
            ),

            const SizedBox(height: 10),

            // Scale Button
            ElevatedButton(
              onPressed: () {
                playAnimation('Scale');
              },
              child: const Text('Scale'),
            ),

            const SizedBox(height: 10),

            // Rotation Button
            ElevatedButton(
              onPressed: () {
                playAnimation('Rotation');
              },
              child: const Text('Rotation'),
            ),
          ],
        ),
      ),
    );
  }
}

// Simple square used for all animations
class Box extends StatelessWidget {
  const Box({super.key});

  @override
  Widget build(BuildContext context) {
    return Container(
      width: 120,
      height: 120,
      color: Colors.indigo,
    );
  }
}
