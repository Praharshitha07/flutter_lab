import 'package:flutter/material.dart';

void main() {
  runApp(MaterialApp(
    home: FoodPage(),
  ));
}

class FoodPage extends StatelessWidget {
  const FoodPage({super.key});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: Text("Food Ordering"),
      ),

      body: Column(
        children: [
          FoodCard(
            icon: Icons.local_pizza,
            name: "Pizza",
            price: "₹200",
          ),

          FoodCard(
            icon: Icons.lunch_dining,
            name: "Burger",
            price: "₹120",
          ),

          FoodCard(
            icon: Icons.rice_bowl,
            name: "Biryani",
            price: "₹180",
          ),
        ],
      ),
    );
  }
}

// Custom Widget
class FoodCard extends StatelessWidget {
  final IconData icon;
  final String name;
  final String price;

  const FoodCard({
    super.key,
    required this.icon,
    required this.name,
    required this.price,
  });

  @override
  Widget build(BuildContext context) {
    return Card(
      margin: EdgeInsets.all(10),
      child: Row(
        children: [
          Icon(icon, size: 50, color: Colors.orange),

          SizedBox(width: 15),

          Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              Text(
                name,
                style: TextStyle(
                  fontSize: 20,
                  fontWeight: FontWeight.bold,
                ),
              ),

              Text(price),

              ElevatedButton(
                onPressed: () {},
                child: Text("ADD TO CART"),
              ),
            ],
          ),
        ],
      ),
    );
  }
}
